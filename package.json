{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal expense tracker with MCP server for AI agents",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run dev --workspace=@expense/mobile",
    "dev:desktop": "npm run dev --workspace=@expense/desktop",
    "dev:mcp": "npm run dev --workspace=@expense/mcp-server",
    "build:all": "npm run build --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}