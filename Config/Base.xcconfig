// Shared MonMon build settings.

PRODUCT_NAME = MonMon

// Flavour identity. APP_BUNDLE_ID, ICLOUD_CONTAINER_ID and APP_DISPLAY_NAME are
// set per configuration in Debug.xcconfig (dev) and Release.xcconfig (prod), so
// the two builds never share a container, an app group, or an iCloud database.
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)
APP_GROUP_ID = group.$(APP_BUNDLE_ID)

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

IPHONEOS_DEPLOYMENT_TARGET = 18.0
MACOSX_DEPLOYMENT_TARGET = 15.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
TARGETED_DEVICE_FAMILY = 1
SUPPORTS_MACCATALYST = NO

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.finance
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_NSFaceIDUsageDescription = MonMon uses Face ID to keep your balances private.
INFOPLIST_FILE = MonMon/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = $(APP_ICON_NAME)

ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO
CODE_SIGN_STYLE = Automatic
