{
  "sourceLanguage": "en",
  "strings": {
    "%/year": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%/năm"
          }
        }
      }
    },
    "%@ %@ them, no account": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ họ, chưa có tài khoản"
          }
        }
      }
    },
    "%@ changed its reply. Add the item by hand for now.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã đổi cách trả dữ liệu. Tạm thời hãy thêm bằng tay."
          }
        }
      }
    },
    "%@ could not be reached.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được %@."
          }
        }
      }
    },
    "%@ listed nothing.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không trả về gì."
          }
        }
      }
    },
    "%@ of %@ %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trong %@ %@"
          }
        }
      }
    },
    "%@ of %@ repaid": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã trả %@ trong %@"
          }
        }
      }
    },
    "%@ of %@ returned": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã nhận lại %@ trong %@"
          }
        }
      }
    },
    "%@ of what moved": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ số tiền đã dịch chuyển"
          }
        }
      }
    },
    "%@ outstanding after this payment.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn nợ %@ sau lần trả này."
          }
        }
      }
    },
    "%@ still held across every open position in %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn nắm %@ trên mọi vị thế đang mở của %@."
