      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Đang lấy tỷ giá hôm nay…" } } }
    },
    "CoinGecko rate. Change it to the rate you paid.": {
      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Tỷ giá CoinGecko. Đổi lại thành tỷ giá bạn đã trả." } } }
    },
    "Checked a moment ago. Type the rate you paid.": {
      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Vừa kiểm tra xong. Hãy tự nhập tỷ giá bạn đã trả." } } }
    },
    "Couldn’t fetch a rate. Type the rate you paid.": {
      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Không lấy được tỷ giá. Hãy tự nhập tỷ giá bạn đã trả." } } }
    },
