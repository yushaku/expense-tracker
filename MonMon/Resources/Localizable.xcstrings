      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld khoản nắm giữ"
          }
        }
      }
    },
    "%lld positions have no instrument, so %@ of cost is counted as worth nothing. Open each one and pick what it is held in.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld khoản nắm giữ chưa gắn sản phẩm, nên %@ tiền vốn bị tính là không có giá trị. Mở từng khoản và chọn nơi nắm giữ."
          }
        }
      }
    },
    "%lld sales": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lệnh bán"
          }
        }
      }
