      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Nhập tỷ giá bạn đã trả, tính bằng đồng mỗi đô la." } } }
    },
    "Enter the rate you were paid, in đồng per dollar.": {
      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Nhập tỷ giá bạn đã nhận, tính bằng đồng mỗi đô la." } } }
