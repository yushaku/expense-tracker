        }
      }
    },
    "%@ still held after this sale.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn nắm %@ sau lệnh bán này."
          }
        }
      }
    },
    "%@ still held in this position.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn nắm %@ trong vị thế này."
          }
        }
      }
    },
    "%@ still outstanding %@ %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ còn nợ %@ %@."
          }
        }
      }
    },
    "%@ · %@ %@ as of %@. Edit the price under Instruments.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ %@ tính đến %@. Sửa giá trong mục Sản phẩm."
          }
        }
      }
    },
    "%@ · Stale": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Giá cũ"
          }
        }
      }
    },
    "%@, %@, %@ of %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@, %@ trong %@"
          }
        }
      }
    },
    "%@, %@, %@ of cash": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@, %@ tiền mặt"
          }
        }
      }
    },
    "%lld %@ held in this. Delete them first.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ đang giữ theo mục này. Xoá chúng trước."
          }
        }
      }
    },
    "%lld active rules": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lịch đang chạy"
          }
        }
      }
    },
    "%lld active rules · %lld paused": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lịch đang chạy · %lld tạm dừng"
