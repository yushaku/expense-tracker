          }
        }
      }
    },
    "Asking %@ which %@ it lists…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang hỏi %@ xem có những %@ nào…"
          }
        }
      }
    },
    "Asks for %@ when the app opens, and again after a minute away. This hides the screen; it does not encrypt the file your records are stored in.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi %@ mỗi khi mở ứng dụng, và hỏi lại sau một phút rời đi. Cách này chỉ che màn hình, không mã hoá tệp lưu dữ liệu của bạn."
          }
        }
      }
    },
