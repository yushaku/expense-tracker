          }
        }
      }
    },
    "Another %@ category already has this name.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có một danh mục %@ khác mang tên này."
          }
        }
      }
    },
    "Any account balance it moved returns to what it was.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư tài khoản mà nó đã làm thay đổi sẽ trở lại như cũ."
