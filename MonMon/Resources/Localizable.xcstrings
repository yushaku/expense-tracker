      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giao dịch"
          }
        }
      }
    },
    "%lld transactions use this category. You will pick where they go.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giao dịch đang dùng danh mục này. Bạn sẽ chọn nơi chuyển chúng sang."
          }
        }
      }
    },
