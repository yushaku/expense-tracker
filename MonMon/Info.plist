<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_ID).quick-capture</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(QUICK_CAPTURE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>MonMonAppGroupIdentifier</key>
	<string>$(APP_GROUP_ID)</string>
	<key>MonMonCloudKitContainer</key>
	<string>$(ICLOUD_CONTAINER_ID)</string>
	<key>MonMonQuickCaptureURLScheme</key>
	<string>$(QUICK_CAPTURE_URL_SCHEME)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MonMon uses the microphone to turn one spoken transaction into text on this device.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MonMon transcribes one spoken transaction entirely on this device for Quick Capture.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
