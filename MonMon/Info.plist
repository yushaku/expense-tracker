<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>MonMon connects directly to your paired device to sync data you review.</string>
    <key>NSCameraUsageDescription</key>
    <string>Scan the pairing code displayed by MonMon on your Mac.</string>
    <key>NSBonjourServices</key>
    <array><string>_monmon-dev._tcp</string><string>_monmon._tcp</string></array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_ID).quick-capture</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(QUICK_CAPTURE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>MonMonAppGroupIdentifier</key>
	<string>$(APP_GROUP_ID)</string>
	<key>MonMonQuickCaptureURLScheme</key>
	<string>$(QUICK_CAPTURE_URL_SCHEME)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.monmon.quick-expense-position</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.data</string></array>
			<key>UTTypeDescription</key>
			<string>Quick Expense Position</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
