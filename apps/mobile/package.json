{
  "name": "@expense/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Expo mobile app for iOS and macOS Desktop",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "dev:ios": "expo start --ios",
    "dev:macos": "expo start --web",
    "build": "expo export --platform all",
    "build:ios": "expo export --platform ios",
    "build:macos": "expo export --platform web",
    "lint": "eslint .",
    "test": "jest",
    "clean": "rmrf .expo dist node_modules"
  },
  "dependencies": {
    "@expense/domain": "workspace:*",
    "@expense/shared": "workspace:*",
    "@expense/ui": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-constants": "^18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-linking": "^8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "tamagui": "^1.100.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.17",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^12.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
